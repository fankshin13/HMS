# 전체 환경 변수 목록 (이름만 기록, 값은 비워 둠). 실제 값은 커밋하지 않는다.
# 서비스별 상세 설명: backend/.env.example, frontend/.env.example

# --- 백엔드 / 데이터베이스 / 브로커 ---
DATABASE_URL=
REDIS_URL=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=

# --- 암호화 및 보안 (시크릿) ---
APP_SECRET_KEY=
INVITATION_TOKEN_SALT=

# --- 애플리케이션 런타임 ---
PORT=
APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NODE_ENV=
PYTHON_ENV=
TZ=
