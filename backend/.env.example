# 값은 비워 두고, 실제 값은 배포 환경의 서버 측 시크릿 저장소에서 주입한다.

# PostgreSQL 15+ 접속 DSN
DATABASE_URL=
# Celery 브로커 및 캐시용 Redis 7.x DSN
REDIS_URL=

# S3 호환 임시 오브젝트 스토리지 (진단 로그·보고서 버퍼)
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=

# 세션 서명 및 AES-256-GCM 데이터 암호화 마스터 키 (시크릿)
APP_SECRET_KEY=
# 단일 사용 초대 링크 토큰 해싱 솔트 (시크릿, frontend 와 같은 값)
INVITATION_TOKEN_SALT=
# 서비스 기본 주소 (소유자 초대 링크 생성용)
APP_URL=

# API 서버 포트
PORT=
# development | production | test
PYTHON_ENV=
# 서비스 기준 시간대 (Asia/Seoul)
TZ=

# (테스트 전용) 로컬 PostgreSQL 관리자 접속 URL. DB 테스트가 일회용 DB 를 만들고 지운다. localhost 만 허용
TEST_DATABASE_URL=

# 판정 워커: Supabase 프로젝트 URL 과 service role 키(시크릿, 백엔드 전용 — 원본 로그 비공개 버킷 읽기)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 선택: 보고서 PDF·차트 글꼴 폴더(Pretendard-Regular.otf, Pretendard-Bold.otf)
REPORT_FONT_DIR=
